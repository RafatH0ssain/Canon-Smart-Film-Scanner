# Normalise line endings so contributors on Windows, macOS and Linux do not
# produce diffs that are nothing but invisible whitespace changes.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary: never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.CR3  binary
*.cr3  binary
*.pdf  binary
*.ico  binary
